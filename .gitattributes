# Byte-exact test artifacts — never let git translate line endings.
# (corpus expected outputs are compared byte-for-byte by tests/run-corpus.mjs)
compiler/tests/corpus/expected/** -text

# Normalised LF for all source (mixes of CRLF/LF are history)
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
