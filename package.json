{
  "name": "laravel-workers",
  "version": "0.5.0",
  "description": "Compile your Laravel app to a tiny JS bundle that runs on Cloudflare Workers. No PHP at the edge, no WASM, no cold-start drama — pure V8 isolates (measured 5 ms CPU p50 / 41 ms p95 on the reference machine), D1, Blade → JS.",
  "keywords": [
    "laravel",
    "cloudflare-workers",
    "workers",
    "edge",
    "d1",
    "blade",
    "cloudflare-d1",
    "transpiler",
    "bun",
    "compile-time",
    "edge-computing",
    "serverless",
    "blade-to-js",
    "php-to-js",
    "toolchain"
  ],
  "type": "module",
  "license": "MIT",
  "author": "arfoux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arfoux/laravel-workers.git"
  },
  "homepage": "https://github.com/arfoux/laravel-workers#readme",
  "bugs": {
    "url": "https://github.com/arfoux/laravel-workers/issues"
  },
  "bin": {
    "laravel-workers": "bin/laravel-workers.mjs"
  },
  "files": [
    "bin",
    "build.mjs",
    "compiler/bin",
    "compiler/blade.mjs",
    "compiler/package-bindings.mjs",
    "compiler/src",
    "compiler/runtime",
    "kernel",
    "src",
    "tools",
    "shadow",
    "docs",
    "MAP.md",
    "COMPILED.md",
    "CHANGELOG.md",
    "!tools/pack-smoke.mjs",
    "!tools/pack-gate.mjs",
    "!tools/tests",
    "!kernel/tests"
  ],
  "scripts": {
    "setup": "npm install && npm --prefix compiler install",
    "test":"node tools/run-tests.mjs","test:fast":"node tools/run-tests.mjs --fast","test:coverage":"node tools/run-tests.mjs --coverage",
    "test:db": "node --test kernel/tests/db.test.mjs",
    "test:sqlite": "node --test kernel/tests/sqlite-integration.test.mjs",
    "test:hash": "node --test kernel/tests/hash.test.mjs kernel/tests/encrypter.test.mjs",
    "test:validator": "node --test kernel/tests/validator.test.mjs",
    "test:corpus": "node compiler/tests/run-corpus.mjs",
    "build": "node build.mjs --strict",
    "verify": "node bin/laravel-workers.mjs verify",
    "test:services": "node --test kernel/tests/services.test.mjs",
    "test:budget": "node --test kernel/tests/budget.test.mjs",
    "check:docs": "node tools/gate.mjs",
    "gate:ci": "npm test && npm run test:corpus && node tools/gate.mjs --strict && node tools/bench.mjs && node tools/check-syntax.mjs && node tools/pack-gate.mjs",
    "gate:cpu": "node tools/cpu-gate.mjs",
    "bench": "node tools/bench.mjs",
    "test:shadow": "node shadow/run.mjs",
    "test:pack": "node tools/pack-smoke.mjs",
    "audit:constructs": "node tools/construct-audit.mjs",
    "test:str": "node --test kernel/tests/str.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.0"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "blade2php": "0.1.3",
    "php-parser": "3.7.0"
  }
}
